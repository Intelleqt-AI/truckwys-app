# Base URL of the Truckwys Django API. Must end with a trailing slash.
# The app calls relative paths like `auth/login/`, `loads/`, etc.
#
# Production — default:
EXPO_PUBLIC_API_URL=https://api.truckwys.com/api/v1/
#
# Local Django (physical device: replace localhost with your machine LAN IP):
# EXPO_PUBLIC_API_URL=http://localhost:8001/api/v1/

# The EAS project id is hardcoded in app.config.ts (extra.eas.projectId) — it
# isn't a secret and never changes, so there is nothing to set here.

# Firebase client config, required to build (see PUSH_SETUP.md). Download both
# from the Firebase console and drop them in the repo root; they are gitignored.
# GOOGLE_SERVICES_INFO_PLIST=./GoogleService-Info.plist
# GOOGLE_SERVICES_JSON=./google-services.json
